# ISO 4217 currency code used by the interface
VITE_CURRENCY=INR

# Base URL of the HerdBook API. Leave empty for same-origin (local dev via the
# Vite proxy, or the combined Express production server). Set this only when the
# client is hosted separately from the API, e.g. the client on Cloudflare Pages
# and the server on Railway/Render:
#   VITE_API_BASE_URL=https://your-api-host.example.com
VITE_API_BASE_URL=
