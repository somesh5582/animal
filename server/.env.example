# MySQL connection for the HerdBook API.
# Copy this file to `.env` and fill in your local MySQL credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=herdbook

# Connection pool size (optional).
DB_CONNECTION_LIMIT=10

# API server port (optional, defaults to 4000).
PORT=4000

# Session lifetime in days (optional, 1-30, defaults to 7).
SESSION_DAYS=7

# Secure flag on the session cookie. Requires HTTPS when enabled.
# Defaults to on when NODE_ENV=production. Set to false to allow login over
# plain HTTP (e.g. accessing the server by IP without a TLS certificate).
#   COOKIE_SECURE=false
COOKIE_SECURE=
